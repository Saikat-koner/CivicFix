# ==============================================================================
# CIVICFIX ENVIRONMENT CONFIGURATION & FREE API KEYS DIRECTORY
# ==============================================================================
# All APIs below have 100% FREE tiers with NO credit card or billing required.
# If no keys are provided, CivicFix automatically falls back to built-in
# zero-cost offline engines (DNS MX verification, OSM Geocoding, Simulated Gateways).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI API (100% Free Tier Available)
# ------------------------------------------------------------------------------
# Powers: Multimodal Vision Image Scanner, Issue Auto-Triage, 24/7 Civic AI Assistant
# Where to get your FREE API key:
# -> https://aistudio.google.com/app/apikey
# Free Tier: 15 Requests/Min, 1 Million Tokens/Min, 1,500 Requests/Day (Zero Cost)
# In AI Studio, this is automatically injected or configured in Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 2. HOSTED APPLICATION URL
# ------------------------------------------------------------------------------
# Automatically populated by Google Cloud Run / AI Studio environment.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# 3. FREE EMAIL DELIVERY APIS (Choose ANY one - No paid plan needed)
# ------------------------------------------------------------------------------
# Powers: 6-Digit Registration OTPs, Password Reset Links, Municipal Work Orders
#
# Option A: Brevo (Formerly Sendinblue) - RECOMMENDED
# Where to get free key: https://app.brevo.com/ (Account > SMTP & API > Generate API Key)
# Free Tier: 300 free emails per day (9,000/month) with zero credit card
BREVO_API_KEY=
#
# Option B: Resend - FAST DEVELOPER API
# Where to get free key: https://resend.com/api-keys (Sign up > Create API Key)
# Free Tier: 100 free emails per day (3,000/month)
RESEND_API_KEY=
#
# Option C: SendGrid Free Tier
# Where to get free key: https://app.sendgrid.com/settings/api_keys
# Free Tier: 100 free emails per day
SENDGRID_API_KEY=

# ------------------------------------------------------------------------------
# 4. FREE SMS & MOBILE OTP DELIVERY APIS (No paid phone number required)
# ------------------------------------------------------------------------------
# Powers: Instant SMS OTP code dispatch to citizen mobile phones
#
# Option A: Textbelt Free Tier (Pre-configured out of the box!)
# Where to get key: https://textbelt.com/
# Default Free Key: "textbelt" (Allows 1 free SMS per day per IP with 0 setup)
TEXTBELT_KEY="textbelt"
#
# Option B: Fast2SMS Quick SMS API (No US/Twilio phone number rental needed)
# Where to get free key: https://www.fast2sms.com/ (Dev API tab)
# Free Tier: Free signup wallet credits for instant OTP delivery to mobile numbers
FAST2SMS_API_KEY=

# ------------------------------------------------------------------------------
# 5. REAL-TIME EMAIL VERIFICATION APIS (Detects fake/invalid emails before OTP)
# ------------------------------------------------------------------------------
# Note: If left blank, CivicFix automatically uses its built-in FREE DNS MX
# record resolver and disposable domain engine (100% zero cost, no key required).
#
# Option A: ZeroBounce Free Tier
# Where to get free key: https://www.zerobounce.net/members/api-keys/
# Free Tier: 100 free email validations per month
ZEROBOUNCE_API_KEY=
#
# Option B: Abstract Email Validation API
# Where to get free key: https://www.abstractapi.com/api/email-verification-validation-api
# Free Tier: 100 free API requests per month
ABSTRACT_EMAIL_API_KEY=

# ------------------------------------------------------------------------------
# 6. FREE MAPS, REVERSE GEOCODING & GIS (Zero Keys Needed)
# ------------------------------------------------------------------------------
# Pre-integrated open-source providers:
# - OpenStreetMap Nominatim: https://nominatim.openstreetmap.org/ (100% Free, no key)
# - CartoDB Positron / Voyager: Open GIS tiles (100% Free, no key)
# - Esri World Imagery & Dark Gray Canvas: (Free public service tiles, no key)

# ------------------------------------------------------------------------------
# 7. SUPABASE (Database & Authentication)
# ------------------------------------------------------------------------------
# Powers: User Authentication, OAuth logins (Google, GitHub), Row Level Security
# Where to get your free credentials:
# -> https://supabase.com/dashboard/project/_/settings/api
# Free Tier: Unlimited API requests, 50,000 monthly active users (100% Free)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

